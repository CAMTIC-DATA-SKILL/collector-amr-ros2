# 이 파일을 .env 로 복사해서 쓴다. 비워 둔 값은 config.py 의 기본값을 따른다.
# run.sh 가 .env 가 없으면 이 파일을 복사한다.

# 로깅: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# 게이트웨이 IPC (ZeroMQ)
# 토픽: collector.robot.{DEVICE_KEY}.{data|health|ack}
# DEVICE_KEY 에 '.' 와 공백은 쓸 수 없다.
DEVICE_KEY=amr-scout-1
GATEWAY_ADDRESS=gateway

# 엣지 PC 가 이 포트로 접속한다. 루프백(127.0.0.1)이면 엣지에서 안 보인다.
# 로봇 안에서만 확인하려면 127.0.0.1 로 구독한다 (python -m core.zeromq_client).
# 엣지 collector 포트(5556~5561)와 호스트가 다르므로 번호가 같아도 된다. 5570 을 쓴다.
ZMQ_PUB_ENDPOINT=tcp://0.0.0.0:5570
ZMQ_PUB_BIND=true
# 비우면 cmd 를 구독하지 않는다. 엣지 포워더는 cmd 를 보내지 않는다.
ZMQ_SUB_ENDPOINT=
ZMQ_SUB_BIND=false
ZMQ_RECV_TIMEOUT_MS=100
ZMQ_LINGER_MS=0

# 수집 주기(초). 토픽은 더 빨라도 이 간격으로만 DATA 를 보낸다.
POLL_INTERVAL_SEC=1.0
# 이 시간(초) 동안 /wheel_odom 과 /scout_status 가 둘 다 없으면 device_ok=false
STALE_SEC=3.0

# 매뉴얼에 있는 토픽 이름. 비우면 그 토픽은 구독하지 않는다.
SCOUT_STATUS_TOPIC=/scout_status
ODOM_TOPIC=/wheel_odom
AMCL_POSE_TOPIC=/amcl_pose
SCAN_TOPIC=/scan

# ROS 그래프가 안 보이면 여기 적는다. 비우면 run.sh 가 맞춰 본다.
# 1) 이미 떠 있는 scout_base_node 의 환경
# 2) /root/.bashrc 의 export
# 대화형 셸의 `echo $ROS_DOMAIN_ID` 와 다르면 그 값을 여기에 적는다.
ROS_DOMAIN_ID=
ROS_LOCALHOST_ONLY=
RMW_IMPLEMENTATION=
CYCLONEDDS_URI=
FASTRTPS_DEFAULT_PROFILES_FILE=
